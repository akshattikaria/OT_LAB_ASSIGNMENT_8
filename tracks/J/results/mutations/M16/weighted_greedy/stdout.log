    def test_missing_getsizeof(self):
        class DefaultCache(self.Cache):
            def __missing__(self, key):
                try:
                    self[key] = key
                except ValueError:
                    pass  # not stored
                return key
    
        cache = DefaultCache(maxsize=2, getsizeof=lambda x: x)
    
        self.assertEqual(0, cache.currsize)
