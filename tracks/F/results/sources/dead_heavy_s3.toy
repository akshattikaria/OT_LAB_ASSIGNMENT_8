let value5 = value4 + z;
let dead6 = (x + 6) * (y + z) + (6 * 8);
let value6 = value5 + z;
let dead7 = (x + 7) * (y + z) + (7 * 8);
let value7 = value6 + z;
let dead8 = (x + 8) * (y + z) + (8 * 8);
let value8 = value7 + z;
let dead9 = (x + 9) * (y + z) + (9 * 8);
let value9 = value8 + z;
let dead10 = (x + 10) * (y + z) + (10 * 8);
let value10 = value9 + z;
let dead11 = (x + 11) * (y + z) + (11 * 8);
